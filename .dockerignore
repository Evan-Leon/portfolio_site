# Keep the nginx webroot clean — only ship the actual site assets
# (index.html, 404.html, projects/, assets/, images/).
.git
.gitignore
.gitattributes
.claude
.superpowers
.worktrees
docs
**/.DS_Store
*.md
.env
.env.example
.dockerignore
Dockerfile*
docker-compose.yml

# Dev tooling — Prettier + its git hook. None of this belongs in the served webroot.
node_modules
theater/node_modules
theater/dist
theater/test-results
theater/playwright-report
.githooks
.prettierignore
.prettierrc*

# Agent and repo tooling: skills, their .agents links, scripts, the archive and local logs.
# None of it is site content, and anything in the webroot is public on evanleon.com.
.agents
archive
logs
scripts
skills
